# Absolute URL of the SatQuery FastAPI service (serve/api.py).
# Leave unset to use the same-origin /api rewrite in next.config.ts.
# On Vercel, set this to a publicly reachable backend, or leave it unset and
# the console will show its "backend offline" state with run-it-locally steps.
NEXT_PUBLIC_SATQUERY_API=http://127.0.0.1:8000
